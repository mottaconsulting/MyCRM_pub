# ---------------------------------------------------------------------------
# MyCRM - environment variables
# Copy to .env.local for local dev (never commit real values) and add the same
# keys to your Vercel project. SETUP.md explains where each value comes from.
# ---------------------------------------------------------------------------

# --- Supabase (Project Settings -> API) --- REQUIRED
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only. Bypasses RLS. Never expose to the browser.

# --- Site URL ---
# Used to build absolute URLs for server-to-server self-calls. On Vercel this is
# derived automatically (VERCEL_PROJECT_PRODUCTION_URL); set it for other hosts.
NEXT_PUBLIC_SITE_URL=                 # e.g. https://mycrm.example.com

# --- Login form convenience (optional) ---
# Pre-fills the email box on the login page. This is NOT an access gate:
# tenant isolation is enforced by Postgres RLS, not by this value.
NEXT_PUBLIC_ALLOWED_USER_EMAIL=

# --- Microsoft Graph (Azure App Registration) --- needed for mail/calendar sync
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=                      # https://<your-app>/api/ms/callback

# --- Google Gemini --- needed for AI summaries, signature extraction, nurture + campaign drafts
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest      # optional; defaults to the rolling Flash alias

# --- Web search (optional) --- used to auto-find LinkedIn profile URLs
# Configure ONE backend. Serper is tried first if both are set.
SERPER_API_KEY=                       # https://serper.dev
GOOGLE_CSE_KEY=                       # Google Programmable Search API key
GOOGLE_CSE_CX=                        # Google Programmable Search engine id

# --- Background sync shared secret --- REQUIRED for /api/sync/* endpoints
# Any long random string. Vercel Cron sends it automatically as a Bearer token
# when this env var is set; a Supabase pg_cron job must send the same value.
CRON_SECRET=

# --- Suggestion filtering (optional) ---
# Comma-separated email domains to keep out of contact suggestions
# (schools, clubs, personal mailing lists, etc.).
SUGGEST_EXCLUDE_DOMAINS=
